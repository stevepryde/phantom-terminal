{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Phantom Terminal",
  "version": "0.1.2",
  "identifier": "com.phantom.terminal",
  "build": {
    "beforeDevCommand": "bun run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "bun run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Phantom Terminal",
        "width": 1000,
        "height": 700,
        "minWidth": 480,
        "minHeight": 320,
        "acceptFirstMouse": true,
        "decorations": false,
        "transparent": true,
        "shadow": true,
        "dragDropEnabled": false
      }
    ],
    "macOSPrivateApi": true,
    "security": {
      "csp": "default-src 'self'; img-src 'self' data:; style-src 'self' 'unsafe-inline'; script-src 'self' 'wasm-unsafe-eval'; connect-src 'self' ipc: http://ipc.localhost; worker-src 'self' blob:; font-src 'self' data:; wasm-src 'self'"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "DeveloperTool",
    "shortDescription": "A terminal that remembers your tabs and sessions",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "linux": {
      "deb": {
        "desktopTemplate": "linux/phantom-terminal.desktop"
      },
      "rpm": {
        "desktopTemplate": "linux/phantom-terminal.desktop"
      }
    }
  }
}
