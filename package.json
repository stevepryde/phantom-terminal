{
  "name": "phantom-terminal",
  "private": true,
  "version": "0.1.1",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "tauri": "tauri",
    "update": "bash scripts/update-local.sh",
    "typecheck": "tsc --noEmit",
    "lint": "biome check src scripts package.json tsconfig.json vite.config.ts biome.json",
    "format": "biome format --write .",
    "test": "bun test",
    "audit": "bun audit --audit-level=high",
    "sbom:js": "bun scripts/sbom-js.ts sbom-js.json"
  },
  "trustedDependencies": [],
  "dependencies": {
    "@tauri-apps/api": "2.11.0",
    "ghostty-web": "0.4.0-next.14.g6a1a50d",
    "lucide-react": "1.16.0",
    "react": "19.2.6",
    "react-dom": "19.2.6"
  },
  "devDependencies": {
    "@biomejs/biome": "2.4.15",
    "@tailwindcss/vite": "4.3.0",
    "@tauri-apps/cli": "2.11.2",
    "@types/bun": "1.3.14",
    "@types/react": "19.2.15",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.2",
    "tailwindcss": "4.3.0",
    "typescript": "6.0.3",
    "vite": "8.0.14"
  }
}
